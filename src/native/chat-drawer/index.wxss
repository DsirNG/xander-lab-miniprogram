:host { display:block; width:100%; height:100%; background:transparent; }
.native-drawer-host { position:relative; width:100%; height:100%; overflow:hidden; background:var(--chat-surface,var(--color-surface,#ffffff)); }
.native-drawer-sidebar { transform-origin:left center; will-change:transform,opacity; position:absolute; z-index:1; left:0; top:0; height:100%; overflow:hidden; opacity:0; border-radius:0; }
.native-drawer-foreground { box-shadow:none; filter:drop-shadow(-24px 0 24px rgba(0,0,0,.18)); background:transparent; border-top-left-radius:0; border-bottom-left-radius:0; background-clip:padding-box; position:relative; z-index:3; width:100%; height:100%; overflow:hidden; transform:translate3d(0,0,0); will-change:transform; }
.native-drawer-content { display:flex; flex-direction:column; width:100%; height:100%; min-height:0; }
.native-drawer-navigation { position:absolute; z-index:1000; left:0; right:0; bottom:0; height:calc(80px + env(safe-area-inset-bottom, 0px)); pointer-events:none; overflow:visible; isolation:isolate; }
.native-drawer-navigation .tab-bar { position:absolute; z-index:1001; pointer-events:auto; opacity:1; visibility:visible; }
.native-drawer-navigation .tab-list { position:relative; z-index:1002; display:flex; opacity:1; visibility:visible; overflow:visible; }
.native-drawer-navigation .tab-item { position:relative; z-index:1003; opacity:1; visibility:visible; color:var(--color-ink-muted,#71717a); }
.native-drawer-navigation .tab-item.active { color:var(--color-ink,#18181b); }
@media (prefers-reduced-motion: reduce) { .native-drawer-foreground { transition:none !important; } }

