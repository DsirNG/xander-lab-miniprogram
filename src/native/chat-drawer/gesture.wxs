  state.ready = true;
}
function configureShadow(value, old, owner, instance) { var state = owner.getState(); if (instance) { state.shadow = instance; if (state.width !== undefined) paint(owner, state.x || 0, false); } }
function configureSidebar(value, old, owner, instance) { var state = owner.getState(); if (instance) { state.sidebar = instance; if (state.width !== undefined) paint(owner, state.x || 0, false); } }
function start(event, owner) {
  var state = owner.getState();
  state.touch = null;
  if (!state.enabled || event.touches.length !== 1) return;
