function end(event, owner) { finish(event, owner, false); }
function cancel(event, owner) { finish(event, owner, true); }
module.exports = { configure:configure, configureShadow:configureShadow, configureSidebar:configureSidebar, start:start, move:move, end:end, cancel:cancel };
